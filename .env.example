# Names of the secrets/settings the app reads (Cloudflare Worker env).
# Local dev: put values in .env.local. Hosted: set as Worker secrets.
# Never commit real values.

# Who may open the dashboard (current auth = ChatGPT sign-in, matched by email).
DASHBOARD_OWNER_EMAIL=

# Local-only login bypass for development.
# LOCAL_DASHBOARD_MODE=true
# LOCAL_DASHBOARD_USER_ID=local
# LOCAL_DASHBOARD_EMAIL=you@example.com

# DessMonitor (inverter).
DESSMONITOR_USERNAME=
DESSMONITOR_PASSWORD=
DESSMONITOR_COMPANY_KEY=

# Tuya Cloud.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_ENDPOINT=https://openapi.tuyaeu.com
TUYA_UID=

# Secret the external scheduler (cron-job.org) sends as x-collection-secret to /api/mobile/collect.
NOTIFICATION_COLLECTION_SECRET=

# Encrypts provider logins saved through the app (random string).
CREDENTIAL_ENCRYPTION_KEY=

# Web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
