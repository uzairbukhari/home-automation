# Copy to .env.local (dev) or set in Vercel -> Settings -> Environment Variables.
# Never commit real values.

# Database. Dev: file:./data.db (leave token empty). Prod: Turso URL + token.
DATABASE_URL=file:./data.db
DATABASE_AUTH_TOKEN=

# Auth: random 32+ char string, and bcrypt hash from `npm run hash-password -- "pw"`.
SESSION_SECRET=
DASHBOARD_PASSWORD_HASH=

# Bearer secret used by the cron job calling POST /api/poll.
CRON_SECRET=

# DessMonitor (inverter).
DESS_USERNAME=
DESS_PASSWORD=
DESS_COMPANY_KEY=

# Tuya Cloud.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_ENDPOINT=
TUYA_UID=

# Optional tuning.
# INGEST_SCHEDULER=off      # disable the in-process scheduler
# INGEST_INTERVAL_SEC=60
# RETENTION_DAYS=180
# BACKFILL_DAYS=90
